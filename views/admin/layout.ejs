<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <title>ADMIN Panel</title>
    <!-- Bootstrap -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" />
    <!-- Font Awesome Icon -->
    <link rel="stylesheet" href="/css/font-awesome.css">
    <!-- Custom stlylesheet -->
    <link rel="stylesheet" href="/css/style.css">

    <%- typeof tabulatorCSS == 'undefined' ? '' : tabulatorCSS %> 
    <%- typeof summernoteCSS == 'undefined' ? '' : summernoteCSS %> 
    
  </head>
  <body>
    <!-- HEADER -->
    <div id="header-admin">
      <!-- container -->
      <div class="container">
          <!-- row -->
          <div class="row">
            <!-- LOGO -->
            <div class="col-md-2 me-auto">
               <a href="/admin/dashboard"><img class="logo" src="/images/virelix.png" alt="Logo"></a>
            </div>
            <!-- /LOGO -->
          </div>
      </div>
    </div>
    <!-- /HEADER -->
    <!-- Menu Bar -->
    <div id="admin-menubar">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <button class="admin-menu-toggle" type="button" aria-expanded="false" aria-controls="admin-menu">
              <span class="menu-toggle-icon" aria-hidden="true"></span><span class="menu-toggle-label">Menu</span>
            </button>
            <ul class="admin-menu" id="admin-menu">
              <li>
                <a href="/admin/dashboard">Home</a>
              </li>
              <li>
                <a href="/admin/article">Article</a>
              </li>
             <% if(role === 'admin'){ %>
              <li>
                <a href="/admin/category">Category</a>
              </li>
              <li>
                <a href="/admin/users">Users</a>
              </li>
              <% } %>
              <li>
                <a href="/admin/comments">Comments</a>
              </li>
               <% if(role === 'admin'){ %>
              <li>
                <a href="/admin/settings">Settings</a>
              </li>
              <% } %>
              <li class="admin-menu-logout">
                <a href="/admin/logout"><i class="fa fa-sign-out"></i> Logout</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <!-- /Menu Bar -->

  <%- body %> 
  
<!-- Footer -->
<div id ="footer">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <span>© Copyright 2026 News | Powered by <a href="https://www.linkedin.com/in/salauddin-ansari-64178a264/">Salauddin</a></span>
            </div>
        </div>
    </div>
</div>
<!-- /Footer -->
<script>
  (() => {
    const button = document.querySelector(".admin-menu-toggle");
    const menu = document.getElementById("admin-menu");
    if (!button || !menu) return;
    button.addEventListener("click", () => {
      const expanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("is-open", !expanded);
    });
  })();
</script>
</body>
</html>
